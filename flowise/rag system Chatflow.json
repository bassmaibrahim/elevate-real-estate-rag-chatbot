        "inputAnchors": [],
        "inputs": {
          "description": "Search the web for relevant, up-to-date, and high-quality information using Exa Search. Use this tool when you need to find information that is not available in your existing knowledge, verify current facts, research a topic, discover relevant webpages, or retrieve recent information from the internet.\n\nUse the search query to clearly describe what information you need. Prefer specific and meaningful queries that capture the user's intent. Use the results to provide accurate, relevant, and well-supported answers.\n\nThe tool can be used for:\n\n* Finding current or recent information\n* Researching technical topics and documentation\n* Discovering relevant websites, articles, papers, and resources\n* Verifying facts and claims\n* Finding information about companies, products, technologies, or people\n* Retrieving information from webpages relevant to the user's question\n\nDo not use the tool for information that can be answered reliably from the agent's existing knowledge unless the user specifically requests a web search.\n",
          "numResults": "5",
          "type": "magic",
