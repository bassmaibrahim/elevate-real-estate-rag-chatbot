            "id": "retrieverTool_0-input-retriever-BaseRetriever"
          }
        ],
        "inputs": {
          "name": "bassmaibrahim",
          "description": "Retrieve relevant information from the connected knowledge base or vector database based on the user's question.\n\nUse this retriever when the user asks about information contained in the uploaded documents, stored knowledge, or indexed data. Search for the most relevant document chunks and use the retrieved context to generate an accurate answer.\n\nThe retriever should:\n\n* Search the knowledge base using the user's query.\n* Retrieve the most relevant information related to the question.\n* Use semantic similarity to find relevant document content.\n* Return relevant context to the AI agent.\n* Prefer information from the retrieved documents over general knowledge when answering questions about the knowledge base.\n* Avoid retrieving unrelated information.\n* If no relevant information is found, clearly indicate that the answer cannot be determined from the available knowledge base.\n\nDo not use the retriever for general web searches or information that is not contained in the connected knowledge base.\n",
          "retriever": "{{memoryVectorStore_0.data.instance}}",
          "returnSourceDocuments": true
        },
        "outputAnchors": [
          {
            "id": "retrieverTool_0-output-retrieverTool-RetrieverTool|DynamicTool|Tool|StructuredTool|Runnable",
            "name": "retrieverTool",
            "label": "RetrieverTool",
            "description": "Use a retriever as allowed tool for agent",
            "type": "RetrieverTool | DynamicTool | Tool | StructuredTool | Runnable"
          }
        ],
        "outputs": {},
